@using FTShirts.Web.Models.CatalogueModels
@using FTShirts.Web.enums
@model IEnumerable<FTShirts.Web.Models.CatalogueModels.CatalogueItem>

@{
    ViewData["Title"] = "Catalogue";
}

<div class="text-center">
    <h1 class="display-4">Welcome to FT-Shirts</h1>
    <p>Shop for new and second-handed sport t-shirts .</p>
</div>

<div class="container mt-4">
    <h2>Available</h2>
    <div class="mb-4" style="display: flex; gap: 10px;">
        <a href="/Catalogue/Index" class="btn btn-secondary">View whole catalogue</a>
    </div>
    <form action="/Catalogue/Search" method="get" class="d-flex flex-column align-items-end" style="margin-left: auto; max-width: 500px;">

        <div class="d-flex align-items-center mb-3 w-100 justify-content-end">
            <input type="text" name="team" class="form-control me-3" placeholder="Teams ..." style="width: auto;" />

            <div class="form-check me-3 mb-0 d-flex align-items-center">
                <input class="form-check-input me-1" type="checkbox" name="onlyOffer" value="true" id="checkOfertas">
                <label class="form-check-label text-nowrap fw-bold" for="checkOfertas" style="color: black;">
                    On Sale
                </label>
            </div>

            <button type="submit" class="btn btn-info px-4">Submit</button>
        </div>

        <div class="w-100 text-start">

            <button class="btn btn-link text-dark fw-bold p-0 text-decoration-none mb-2" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTags" aria-expanded="false" aria-controls="collapseTags">
                Tags <span style="font-size: 0.8em;">&#11163;</span>
            </button>

            <div class="collapse" id="collapseTags">
                <div class="card card-body p-3 shadow-sm mt-1">
                    <div class="d-flex flex-wrap gap-4">
                        <div class="d-flex flex-column gap-2">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="tags" value="retro" id="tagRetro">
                                <label class="form-check-label fw-bold" for="tagRetro">retro</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="tags" value="season" id="tagSeason">
                                <label class="form-check-label fw-bold" for="tagSeason">26/27 season</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="tags" value="serieA" id="tagSerieA">
                                <label class="form-check-label fw-bold" for="tagSerieA">Serie A</label>
                            </div>
                        </div>

                        <div class="d-flex flex-column gap-2">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="tags" value="laLiga" id="tagLiga">
                                <label class="form-check-label fw-bold" for="tagLiga">La Liga</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="tags" value="premier" id="tagPremier">
                                <label class="form-check-label fw-bold" for="tagPremier">Premier</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>

    <table class="table table-striped">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Team</th>
                <th>Size</th>
                <th>Second-handed</th>
                <th>Original Price</th>
                <th>Offer</th>
                <th>Discount</th>
                <th>Final Price</th>
                <th></th> <!-- In this column we will have the add to shopping cart button-->
            </tr>
        </thead>
       <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.TShirt.Id</td>
            <td>@item.TShirt.Team</td>
            <td>@item.TShirt.Size</td>
            <td>@(item.TShirt.IsSecondHand ? "Yes" : "No")</td>
            <td>
                @if (item.OfferType != Offer.No)
                {
                    <del>@item.TShirt.Price.ToString("0.00") €</del>
                }
                else
                {
                    <span>@item.TShirt.Price.ToString("0.00") €</span>
                }
            </td>
            <td>@item.OfferType</td>
            <td>@(item.OfferDiscount.HasValue ? item.OfferDiscount.Value + "%" : "-")</td>
            <td style="font-weight: bold; color: green;">
                @item.FinalPrice.ToString("0.00") €
            </td>
            <td class="text-center" style="width: 120px;">
                @if (!string.IsNullOrEmpty(Context.Request.Cookies["UserLogged"]))
                {
                    <form action="/User/AddToCart" method="post" class="m-0">
                        <input type="hidden" name="shirtId" value="@item.TShirt.Id" />
                        <button type="submit" class="btn btn-success btn-sm w-100 fw-bold">
                            🛒 Add
                        </button>
                    </form>
                }
            </td>
        </tr>
    }
</tbody>
    </table>
</div>