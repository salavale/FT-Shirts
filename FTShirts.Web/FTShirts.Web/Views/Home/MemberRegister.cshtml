@page
@{
}
<div class="card p-3 mt-4" style="max-width: 400px;">
    <h3>Member Register</h3>
    <form action="/Home/Register" method="post">
        <div class="mb-2">
            <label>Username:</label>
            <input type="text" name="newUsername" class="form-control" required />
        </div>
        <div class="mb-2">
            <label>Password:</label>
            <input type="password" name="newPassword" class="form-control" required />
        </div>
        <button type="submit" class="btn btn-primary w-100">Register</button>
    </form>
    <div class="mb-4" style="display: flex; gap: 10px;">
        <a href="/Home/MemberPage" class="btn btn-secondary">I already have an account</a>
    </div>
</div>