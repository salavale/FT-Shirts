@model FTShirts.Web.Models.User

<div class="container mt-4">
    <h2>Tu Carrito de la Compra</h2>

    @if (Model.ShoppingCart.Count == 0)
    {
        <div class="alert alert-info mt-4">
            Shopping cart is empty
        </div>
        <a href="/Home/Index" class="btn btn-primary mt-2">Return to shop</a>
    }
    else
    {
        <table class="table table-striped align-middle mt-4">
            <thead>
                <tr>
                    <th>Team</th>
                    <th>Details</th>
                    <th class="text-end">Price</th>
                </tr>
            </thead>
            <tbody>
                @{ decimal totalPrice = 0; }
                
                @foreach (var item in Model.ShoppingCart)
                {
                    decimal currentPrice = Model.GetPrice(item);
                    totalPrice += currentPrice;

                    <tr>
                        <td class="fw-bold">@item.TShirt.Team</td>
                        <td>Size: @item.TShirt.Size | second-handed: @(item.TShirt.IsSecondHand ? "Yes" : "No")</td>
                        <td class="text-end">@currentPrice.ToString("0.00") €</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="table-dark">
                    <td colspan="2" class="text-end fw-bold">Total:</td>
                    <td class="text-end fw-bold fs-5">@totalPrice.ToString("0.00") €</td>
                </tr>
            </tfoot>
        </table>

        <div class="d-flex justify-content-end mt-4">
            <a href="/Home/Index" class="btn btn-outline-secondary me-3">Continue Shopping</a>
            <button class="btn btn-success fw-bold px-4">Go to payment</button>
        </div>
    }
</div>