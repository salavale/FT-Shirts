@using FTShirts.Web.Models
@model IEnumerable<FTShirts.Web.Models.CatalogueItem>

@{
    ViewData["Title"] = "Catalogue";
}

<div class="text-center">
    <h1 class="display-4">Welcome to FT-Shirts</h1>
    <p>Shop for new and second-handed sport t-shirts .</p>
</div>

<div class="container mt-4">
    <h2>Available</h2>
    <div class="mb-4" style="display: flex; gap: 10px;">
        <a href="/Home/Index" class="btn btn-secondary">Ver Catálogo Completo</a>
        <a href="/Home/Offers" class="btn btn-success">Ver Solo Ofertas</a>
    </div>

    <table class="table table-striped">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Team</th>
                <th>Size</th>
                <th>Second-handed</th>
                <th>Original Price</th>
                <th>Offer</th>
                <th>Discount</th>
                <th>Final Price</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.TShirt.Id</td>
                    <td>@item.TShirt.Team</td>
                    <td>@item.TShirt.Size</td>
                    <td>@(item.TShirt.IsSecondHand ? "Yes" : "No")</td>
                    <td>
                        @if (item.OfferType == Offer.Yes)
                        {
                            <del>@item.TShirt.Price.ToString("0.00") €</del>
                        }
                        else
                        {
                            <span>@item.TShirt.Price.ToString("0.00") €</span>
                        }
                    </td>

                    <td>@item.OfferType</td>

                    <td>@(item.OfferDiscount.HasValue ? item.OfferDiscount.Value + "%" : "-")</td>

                    <td style="font-weight: bold; color: green;">
                        @item.FinalPrice.ToString("0.00") €
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>