@using FTShirts.Web.Models
@model IEnumerable<FTShirts.Web.Models.CatalogueItem>

@{
    ViewData["Title"] = "Catalogue";
}

<div class="text-center">
    <h1 class="display-4">Welcome to FT-Shirts</h1>
    <p>Shop for new and second-handed sport t-shirts .</p>
</div>

<div class="container mt-4">
    <h2>Available</h2>
    <div class="mb-4" style="display: flex; gap: 10px;">
        <a href="/Home/Index" class="btn btn-secondary">View whole catalogue</a>
    </div>
    <form action="/Home/SSearch" method="get" class="d-flex" style="margin-left: auto;">
        <input type="text" name="team" class="form-check search" placeholder="Team"/>
        <div class="form-check me-2 mb-0 d-flex align-items-center">
            <input class="form-check-input me-1" type="checkbox" name="onlyOffer" value="true" id="checkOfertas">
            <label class="form-check-label text-nowrap" for="checkOfertas" style="color: black;">
                On Sale
            </label>
        </div>
        <button type="submit" class="btn btn-outline-success">Search</button>
    </form>

    <table class="table table-striped">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Team</th>
                <th>Size</th>
                <th>Second-handed</th>
                <th>Original Price</th>
                <th>Offer</th>
                <th>Discount</th>
                <th>Final Price</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.TShirt.Id</td>
                    <td>@item.TShirt.Team</td>
                    <td>@item.TShirt.Size</td>
                    <td>@(item.TShirt.IsSecondHand ? "Yes" : "No")</td>
                    <td>
                        @if (item.OfferType == Offer.Yes)
                        {
                            <del>@item.TShirt.Price.ToString("0.00") €</del>
                        }
                        else
                        {
                            <span>@item.TShirt.Price.ToString("0.00") €</span>
                        }
                    </td>

                    <td>@item.OfferType</td>

                    <td>@(item.OfferDiscount.HasValue ? item.OfferDiscount.Value + "%" : "-")</td>

                    <td style="font-weight: bold; color: green;">
                        @item.FinalPrice.ToString("0.00") €
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>