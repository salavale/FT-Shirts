@{
    ViewData["Title"] = "Welcome";
}

<div class="text-center mt-5">
    <h1 class="display-3 fw-bold">FT-Shirts</h1>
    <p class="lead text-muted mb-5">Shop for new and second-handed sport t-shirts.</p>

    <div class="d-flex justify-content-center gap-3">
        <a href="/Catalogue/Index" class="btn btn-primary btn-lg px-4">
            Browse Catalogue
        </a>
        @if (!string.IsNullOrEmpty(Context.Request.Cookies["UserLogged"]))
        {
             <a href="/User/SellShirt" class="btn btn-warning me-2 fw-bold">
                Sell Shirt 👕
            </a>    
        }
        else
        {
            <a href="/User/UserPage" class="btn btn-outline-dark btn-lg px-4">
                Sign In / Register
             </a>   
        }
    </div>
</div>